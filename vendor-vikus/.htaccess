<IfModule mod_headers.c>
	# Long-lived cache for static viewer assets (no mod_expires required).
	<FilesMatch "\.(jpg|jpeg|png|gif|swf|csv|js|css|json|woff2?|ttf|svg)$">
		Header set Cache-Control "max-age=31536000, public"
	</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
	<FilesMatch "\.(js|csv|css|json|svg|html)$">
		SetOutputFilter DEFLATE
	</FilesMatch>
</IfModule>
